{
  "schemaVersion": 1,
  "id": "com.github.linuxgameruk.omafinsight",
  "name": "OmaFinSight",
  "version": "2.0.0",
  "author": "LinuxGamerUK",
  "license": "MIT",
  "description": "OmaFinSight — your FinSight balance forecast as a native Omarchy bar widget + desktop app: expected balance today, month-end and year-end across your accounts, per-account list, low-balance warnings, privacy-eye quick hide, and a full native charts app window. Reads from your self-hosted FinSight instance.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "OmaFinSight",
    "description": "Balance forecast from your FinSight instance: today / month-end / year-end, account list, low-balance warnings, privacy-eye hide.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 900,
      "baseUrl": "https://finsight.cresta.digital",
      "warnBalance": 500,
      "criticalBalance": 200,
      "barShows": "today",
      "scope": "primary",
      "hideByDefault": true
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 120,
        "max": 7200,
        "step": 60,
        "defaultValue": 900
      },
      {
        "key": "baseUrl",
        "type": "string",
        "label": "FinSight base URL",
        "defaultValue": "https://finsight.cresta.digital"
      },
      {
        "key": "warnBalance",
        "type": "integer",
        "label": "Low-balance warning threshold",
        "min": 0,
        "max": 100000,
        "step": 50,
        "defaultValue": 500
      },
      {
        "key": "criticalBalance",
        "type": "integer",
        "label": "Critical-balance threshold",
        "min": 0,
        "max": 100000,
        "step": 50,
        "defaultValue": 200
      },
      {
        "key": "barShows",
        "type": "enum",
        "label": "Bar shows",
        "options": [
          "today",
          "month-end",
          "year-end",
          "none"
        ],
        "defaultValue": "today"
      },
      {
        "key": "scope",
        "type": "enum",
        "label": "Account scope",
        "options": [
          "primary",
          "all"
        ],
        "defaultValue": "primary"
      },
      {
        "key": "hideByDefault",
        "type": "boolean",
        "label": "Start with amounts hidden (privacy eye)",
        "defaultValue": true
      }
    ]
  },
  "repository": "https://github.com/LinuxGamerUK/omafinsight"
}